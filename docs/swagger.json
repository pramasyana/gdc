    "definitions": {
        "github_com_ryanpramasyana_gdc_internal_package_auth_handler_dto_request.LoginRequest": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "jane@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "secret123"
                }
            }
        },
        "github_com_ryanpramasyana_gdc_internal_package_auth_handler_dto_request.LogoutRequest": {
