                    "maxLength": 120,
                    "minLength": 1,
                    "example": "Jane Doe"
                },
                "password": {
                    "type": "string",
                    "minLength": 8,
                    "example": "secret123"
                },
                "team_name": {
                    "type": "string",
                    "maxLength": 120,
                    "example": "Platform"
                }
            }
        },
